1) Add data using program : 


REPORT zstudent_01reg.

TABLES: zstudent_data.

PARAMETERS:
  p_sid   TYPE zstudent_data-stu_id OBLIGATORY,
  p_name  TYPE zstudent_data-name OBLIGATORY,
  p_dob   TYPE zstudent_data-dob,
  p_gen   TYPE zstudent_data-gender,
  p_email TYPE zstudent_data-email OBLIGATORY,
  p_phone TYPE zstudent_data-phone OBLIGATORY,
  p_addr  TYPE zstudent_data-address.

DATA: lv_email_valid TYPE c LENGTH 1,
      lv_phone_valid TYPE c LENGTH 1,
      lv_studid      TYPE zstudent_data-stu_id.

START-OF-SELECTION.

*--------------------------------------------------------------------*
* Email Validation
*--------------------------------------------------------------------*
  CLEAR lv_email_valid.

  IF p_email CP '*@*.*'.
    lv_email_valid = 'X'.
  ENDIF.

  IF lv_email_valid IS INITIAL.
    MESSAGE 'Invalid Email Address' TYPE 'E'.
  ENDIF.

*--------------------------------------------------------------------*
* Phone Validation
*--------------------------------------------------------------------*
  CLEAR lv_phone_valid.

  IF STRLEN( p_phone ) = 10
     AND p_phone CO '0123456789'.
    lv_phone_valid = 'X'.
  ENDIF.

  IF lv_phone_valid IS INITIAL.
    MESSAGE 'Phone Number must contain 10 digits' TYPE 'E'.
  ENDIF.

*--------------------------------------------------------------------*
* Check Duplicate Student ID
*--------------------------------------------------------------------*
  SELECT SINGLE stu_id
    INTO lv_studid
    FROM zstudent_data
    WHERE stu_id = p_sid.

  IF sy-subrc = 0.
    MESSAGE 'Student ID Already Exists' TYPE 'E'.
  ENDIF.

*--------------------------------------------------------------------*
* Prepare Data
*--------------------------------------------------------------------*

  CLEAR zstudent_data.

  zstudent_data-stu_id  = p_sid.
  zstudent_data-name    = p_name.
  zstudent_data-dob     = p_dob.
  zstudent_data-gender  = p_gen.
  zstudent_data-email   = p_email.
  zstudent_data-phone   = p_phone.
  zstudent_data-address = p_addr.


  INSERT zstudent_data.

  IF sy-subrc = 0.
    COMMIT WORK.
    MESSAGE 'Student Registered Successfully' TYPE 'S'.
  ELSE.
    ROLLBACK WORK.
    MESSAGE 'Error While Saving Record' TYPE 'E'.
  ENDIF.




